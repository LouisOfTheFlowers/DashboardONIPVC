      "semester_field": "semestre",
      "uo_field": "",
      "config_group": "descricao",
      "show_table": false,
      "items": [
        {
          "key": "por_lecionar",
          "value": 1,
          "source_label": "Por lecionar",
          "label": "Por Lecionar",
          "color": "warning",
          "ranges": [
            { "min": 0, "max": 2, "color": "success" },
            { "min": 3, "max": 5, "color": "warning" },
            { "min": 6, "max": 999, "color": "critical" }
          ],
          "table_ranges": [
            { "min": 0, "max": 2, "color": "success" },
            { "min": 3, "max": 5, "color": "warning" },
            { "min": 6, "max": 999, "color": "critical" }
          ]
        },
        {
          "key": "nao_lecionadas",
          "value": 3,
          "source_label": "Não lecionada",
          "label": "Não Lecionadas",
          "color": "critical",
          "empty_display": "dash",
          "ranges": [
            { "min": 0, "max": 2, "color": "success" },
            { "min": 3, "max": 5, "color": "warning" },
            { "min": 6, "max": 999, "color": "critical" }
          ],
          "table_ranges": [
            { "min": 0, "max": 2, "color": "success" },
            { "min": 3, "max": 5, "color": "warning" },
            { "min": 6, "max": 999, "color": "critical" }
          ]
        },
        {
          "key": "nao_justificadas",
          "value": 7,
          "source_label": "Não Justificada",
          "label": "Não Justificadas",
          "color": "danger",
          "empty_display": "dash",
          "ranges": [
            { "min": 0, "max": 2, "color": "success" },
            { "min": 3, "max": 5, "color": "warning" },
            { "min": 6, "max": 999, "color": "critical" }
