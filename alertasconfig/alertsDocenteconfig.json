{
  "_meta": {
    "schema_version": 1,
    "dashboard": "docente",
    "data_file": "alertsDocente.json"
  },

  "card_colors": {
    "success": "#22c55e",
    "warning": "#eab308",
    "critical": "#ef4444",
    "danger": "#dc2626",
    "info": "#2563eb"
